@merge module Stripe {
    class InvoiceStatus {
        setupStringEnum[];
        enumStringValue[DRAFT, "draft"];
        enumStringValue[OPEN, "open"];
        enumStringValue[PAID, "paid"];
        enumStringValue[UNCOLLECTIBLE, "uncollectible"];
        enumStringValue[VOID, "void"];
    }

    class InvoiceCollectionMethod {
        setupStringEnum[];
        // Stripe charges the customer's default payment method.
        enumStringValue[CHARGE_AUTOMATICALLY, "charge_automatically"];
        // Stripe emails the invoice and the customer pays it manually.
        enumStringValue[SEND_INVOICE, "send_invoice"];
    }

    class Invoice {
        def id: String;
        def customerId: String;
        def status: Nullable[InvoiceStatus];
        def currency: String;
        def amountDue: Int[64];
        def amountPaid: Int[64];
        def hostedInvoiceUrl: Nullable[String];
        def collectionMethod: InvoiceCollectionMethod;
        def dueDate: Nullable[Int[64]];
        def created: Int[64];
        def metadata: Map[String, String];

        handler this~init() {
        }

        handler this~init(
            id: String, customerId: String, status: Nullable[InvoiceStatus], currency: String, amountDue: Int[64],
            amountPaid: Int[64], hostedInvoiceUrl: Nullable[String], collectionMethod: InvoiceCollectionMethod,
            dueDate: Nullable[Int[64]], created: Int[64], metadata: Map[String, String]
        ) {
            this.id = id;
            this.customerId = customerId;
            this.status = status;
            this.currency = currency;
            this.amountDue = amountDue;
            this.amountPaid = amountPaid;
            this.hostedInvoiceUrl = hostedInvoiceUrl;
            this.collectionMethod = collectionMethod;
            this.dueDate = dueDate;
            this.created = created;
            this.metadata = metadata;
        }
    }
}
